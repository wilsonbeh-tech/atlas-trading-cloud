# Moomoo MCP HTTP transport (only needed for `fetch` and `run --execute`).
# For the Qoder MCP tools path, leave these unset and follow skills/momo-momentum.
MOOMOO_MCP_URL=https://mcp.moomoo.com/mcp
MOOMOO_MCP_TOKEN=

# Optional: absolute path to a Node 20+ binary if `node` is not on PATH.
# QODER_EXE=C:\Users\<you>\AppData\Local\Programs\Qoder\Qoder.exe

# Set DEBUG=1 for stack traces.
DEBUG=
